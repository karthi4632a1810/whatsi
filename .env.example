# WATI
token=
url=https://live-mt-server.wati.io/10190409
WATI_TEMPLATE_NAME=mapims_lab_rpt
WATI_SEND_ENABLED=false
WATI_TEST_MODE=true
WATI_TEST_PHONE=919360635207
# Cache WATI contacts & connection checks (milliseconds) — reduces API usage
WATI_CONTACTS_CACHE_MS=1800000
WATI_CONNECTION_CACHE_MS=900000

# Server
PORT=5001
MONGODB_URI=mongodb://localhost:27017/whatsi
JWT_SECRET=change-me-in-production

# Admin seed (npm run seed)
ADMIN_EMAIL=admin@mapims.edu.in
ADMIN_PASSWORD=admin123

# EMR / HIS
EMR_QUERY_BUILDER_URL=https://emr.mapims.edu.in/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1
EMR_LAB_SERVICES_URL=https://emr.mapims.edu.in/BB15SE/Lab/wsLabServices.asmx/RETDatatable
EMR_REPORT_BASE_URL=https://emr.mapims.edu.in/BB15SE/Lab/CRReport/LabReport.aspx
EMR_STR_CON=BB_CONSTR
EMR_LAB_STR_CON=LAB_CONSTR
EMR_SQL_DATE_ORDER=mdy
EMR_POLL_ENABLED=true
EMR_POLL_CRON=*/15 * * * *
# EMR_PROCIDS_QUERY=Exec YourProc @OrderID={orderId}
# EMR login for automatic Procids discovery from LabResultHis.aspx (optional — prefer env over hardcoding)
EMR_USERNAME=
EMR_PASSWORD=
# Or paste Cookie header from a logged-in EMR browser session:
# EMR_COOKIE=ASP.NET_SessionId=...; .ASPXAUTH=...
EMR_LAB_RESULT_HIS_URL=https://emr.mapims.edu.in/BB15SE/Lab/LabResultHis.aspx

# Webhooks
HIS_WEBHOOK_SECRET=

# Cron
EOD_CRON=0 18 * * *
RETRY_CRON=*/10 * * * *
