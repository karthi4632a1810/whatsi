# WATI
WATI_TOKEN=
WATI_URL=https://live-mt-server.wati.io/10190409
WATI_TEMPLATE_NAME=mapims_lab_rpt
WATI_SEND_ENABLED=false
WATI_TEST_MODE=true
WATI_TEST_PHONE=919360635207
# Monthly API call limit for your WATI plan (set your real basic-plan quota)
WATI_BASIC_PLAN_API_LIMIT=10000
# Cache WATI contacts & connection checks (milliseconds) — reduces API usage
WATI_CONTACTS_CACHE_MS=1800000
WATI_CONNECTION_CACHE_MS=900000

# Server
PORT=5001
# Local runs only — docker-compose builds the URI from MONGO_APP_USER / MONGO_APP_PASSWORD.
MONGODB_URI=mongodb://localhost:27017/whatsi

# MongoDB login (docker-compose). Generate passwords with: openssl rand -hex 24
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=whatsi
MONGO_APP_PASSWORD=

# This app's public https address (e.g. https://lab-reports.mapims.edu.in). Set it and
# patients get private links that expire, served by whatsi, instead of the guessable EMR
# report address. WATI must be able to reach it. Leave empty to keep sending EMR links.
PUBLIC_BASE_URL=
REPORT_LINK_DAYS=2
# Signs staff logins. Required — generate with: openssl rand -hex 32
# (missing/weak → a random one per run, and everyone is logged out on restart)
JWT_SECRET=
# Extra browser origins allowed to call the API (comma-separated). Empty = same origin only.
CORS_ORIGINS=

# Admin seed (npm run seed)
ADMIN_EMAIL=admin@mapims.edu.in
ADMIN_PASSWORD=admin123

# EMR / HIS
EMR_QUERY_BUILDER_URL=https://emr.mapims.edu.in/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1
EMR_LAB_SERVICES_URL=https://emr.mapims.edu.in/BB15SE/Lab/wsLabServices.asmx/RETDatatable
EMR_REPORT_BASE_URL=https://emr.mapims.edu.in/BB15SE/Lab/CRReport/LabReport.aspx
EMR_STR_CON=BB_CONSTR
EMR_LAB_STR_CON=LAB_CONSTR
EMR_SQL_DATE_ORDER=mdy
EMR_POLL_ENABLED=true
EMR_POLL_CRON=*/15 * * * *
# Re-check this many past days for late READY completions (orders finished after their lab day)
EMR_BACKLOG_LOOKBACK_DAYS=3
# EMR_PROCIDS_QUERY=Exec YourProc @OrderID={orderId}
# EMR login for automatic Procids discovery from LabResultHis.aspx (optional — prefer env over hardcoding)
EMR_USERNAME=
EMR_PASSWORD=
# Or paste Cookie header from a logged-in EMR browser session:
# EMR_COOKIE=ASP.NET_SessionId=...; .ASPXAUTH=...
EMR_LAB_RESULT_HIS_URL=https://emr.mapims.edu.in/BB15SE/Lab/LabResultHis.aspx

# Webhooks
# HIS "report ready" push — the endpoint is OFF unless this is set (send it as X-HIS-Secret).
HIS_WEBHOOK_SECRET=
# WATI status webhook key (the URL is shown in Settings). Default: derived from JWT_SECRET.
# WATI_WEBHOOK_KEY=

# Sending schedule (delay after approval, night hold, daily time, retries) is set
# in the app: Settings → When reports go out.
